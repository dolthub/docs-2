---
import DocsLayout from "../layouts/DocsLayout.astro";

type MdModule = {
  Content: any;
  frontmatter?: { title?: string };
};

const modules = import.meta.glob<MdModule>("../content/**/*.md", {
  eager: true,
});

export async function getStaticPaths() {
  const mods = import.meta.glob<MdModule>("../content/**/*.md", {
    eager: true,
  });
  return Object.entries(mods)
    .map(([path, mod]) => {
      const rel = path.replace(/^\.\.\/content\//, "");
      if (rel.startsWith(".gitbook/")) return null;
      const noExt = rel.replace(/\.md$/, "");
      const slug = noExt.replace(/\/README$/, "").replace(/^README$/, "");
      if (slug === "") return null; // root index handled by index.astro
      return {
        params: { slug },
        props: {
          title: mod.frontmatter?.title ?? slug.split("/").pop() ?? slug,
          path,
        },
      };
    })
    .filter((p): p is NonNullable<typeof p> => p !== null);
}

const { title, path } = Astro.props as { title: string; path: string };
const mod = modules[path];
const Content = mod.Content;
---

<DocsLayout title={title}>
  <Content />
</DocsLayout>
