    "astro": "^7.2.0",
    "autoprefixer": "^10.5.4",
    "github-markdown-css": "^5.0.0",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.0.0",
    "react-select": "^5.10.2",
    "react-tooltip": "^6.0.8",
