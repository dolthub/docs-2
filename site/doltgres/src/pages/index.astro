---
// The docs root (e.g. https://www.doltgres.com/docs/) redirects to the
// "What is Doltgres?" intro page. Static site (no SSR), so this is a
// client/meta redirect: location.replace for browsers/Cypress, a meta refresh
// fallback for no-JS, and a canonical link for crawlers. Production
// additionally gets a true 301 via the _redirects file (see package.json
// build).
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const target = `${base}/introduction`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Doltgres Documentation</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <script define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body>
    <p>Redirecting to <a href={target}>What is Doltgres?</a>…</p>
  </body>
</html>
