---
// Tailwind's base/components/utilities layers. @astrojs/tailwind used to inject
// these; it was dropped in the Astro 7 migration, so they're imported here.
import "../styles/global.css";
import { getGithubStarCount } from "../server/github-stars";
// Components that use react-icons (CJS) must stay client:only
import { Navbar, Footer, ThemeInit } from "../components";
// Components safe for SSR — import directly to avoid pulling in react-icons via barrel
import Search from "../components/Search";
import Sidebar, { MobileSidebar } from "../components/Sidebar";
import type { NavSection } from "../components/Sidebar";
import TableOfContents from "../components/TableOfContents";

export interface Props {
  title: string;
  nav: NavSection[];
  siteName: "dolt" | "doltlab" | "doltgres";
}

const siteLabels: Record<string, string> = {
  dolt: "Dolt Docs",
  doltlab: "DoltLab Docs",
  doltgres: "Doltgres Docs",
};

// Display name used in the social-preview title suffix ("| <App> Documentation").
const appNames: Record<string, string> = {
  dolt: "Dolt",
  doltlab: "DoltLab",
  doltgres: "Doltgres",
};

const { title, nav, siteName } = Astro.props;
const githubStarCount = await getGithubStarCount();
const siteLabel = siteLabels[siteName] || "Docs";
const appName = appNames[siteName] || "Docs";
const currentPath = Astro.url.pathname;
const isDev = import.meta.env.DEV;
// "" (no base) or e.g. "/docs", normalized so paths build as `${base}/asset`.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Social-preview metadata. Astro.site (per-site origin) makes the og:image and
// URLs absolute for scrapers; falls back gracefully if unset.
const siteOrigin = Astro.site ? Astro.site.origin : "";
const socialTitle = `${title} | ${appName} Documentation`;
const ogImage = `${siteOrigin}${base}/og-image.png`;
const pageUrl = `${siteOrigin}${currentPath}`;

// Markdown alternate. Every content page is also served as raw .md by
// pages/[...slug].md.ts — advertise it via <link rel="alternate"> so agents
// and feed-style consumers can discover it without out-of-band knowledge.
// Skip the docs root ("/docs/" -> "/docs.md" doesn't exist).
const trimmedPath = currentPath.replace(/\/$/, "");
const markdownAlternate =
  trimmedPath && trimmedPath !== base ? `${trimmedPath}.md` : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* Apply the saved (or system) theme before paint to avoid a flash.
        The navbar toggle flips this `dark` class and persists `docs-theme`.
        The page background lives in the render-blocking external CSS, which
        isn't applied during the browser's navigation paint-hold — so the root
        canvas would flash light between pages. Set the background and
        color-scheme inline on <html> here (before any CSS) so the very first
        frame is the right theme. Keep these colors in sync with the body
        background rules in the stylesheets below, and with setDarkMode() in
        Navbar.tsx, which clears/sets the same inline styles on toggle. */}
    <script is:inline>
      (function () {
        try {
          // Cross-site theme handoff: the Documentation dropdown's
          // cross-product links carry ?theme=light|dark so the choice
          // follows the user across origins. If present, use it, persist
          // it to this origin's localStorage, and strip the param from
          // the URL so it doesn't stick around on refresh/share.
          var url = new URL(window.location.href);
          var q = url.searchParams.get("theme");
          var dark;
          if (q === "dark" || q === "light") {
            dark = q === "dark";
            try { localStorage.setItem("docs-theme", q); } catch (e) {}
            url.searchParams.delete("theme");
            try {
              history.replaceState(null, "", url.pathname + url.search + url.hash);
            } catch (e) {}
          } else {
            var stored = localStorage.getItem("docs-theme");
            dark = stored
              ? stored === "dark"
              : window.matchMedia("(prefers-color-scheme: dark)").matches;
          }
          var de = document.documentElement;
          if (dark) de.classList.add("dark");
          de.style.colorScheme = dark ? "dark" : "light";
          de.style.backgroundColor = dark ? "#0e141f" : "#f1f3f8";
        } catch (e) {
          /* localStorage/matchMedia/URL unavailable — stay light */
        }
      })();
    </script>

    <title>{title} | {siteLabel}</title>

    {/* Social preview metadata (Open Graph + Twitter Card) */}
    <meta property="og:title" content={socialTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${appName} Documentation`} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} />
    {markdownAlternate && (
      <link rel="alternate" type="text/markdown" href={markdownAlternate} />
    )}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap"
    />
    {!isDev && <link href={`${base}/pagefind/pagefind-ui.css`} rel="stylesheet" />}
    {!isDev && <script is:inline src={`${base}/pagefind/pagefind-ui.js`}></script>}
  </head>
  <body>
    <ThemeInit client:only="react" />
    <div>
      <div class="navbar-slot">
        <Navbar client:only="react" siteName={siteName} githubStarCount={githubStarCount} />
      </div>

      <MobileSidebar client:only="react" nav={nav} currentPath={currentPath} />

      <div class="docs-container">
        <div class="sidebar-slot">
          <Search client:load />
          <Sidebar client:load nav={nav} currentPath={currentPath} />
        </div>

        <main class="docs-main">
          <article class="docs-article" data-pagefind-body>
            <slot />
          </article>
        </main>

        <div class="toc-slot">
          <TableOfContents client:load />
        </div>
      </div>

      <div class="bottomOuter">
        <div class="bottom">
          <Footer client:only="react" />
        </div>
      </div>
    </div>
  </body>
</html>

<style>
  /* Page background — light grey like the blog */
  :global(html) {
    scroll-behavior: auto;
  }

  :global(body) {
    @apply bg-stone-50;
  }

  /* Reserve space for client-only components to prevent layout shift */
  .navbar-slot {
    min-height: 62px;
    background: #070f25;
  }

  @media (min-width: 1024px) {
    .navbar-slot {
      min-height: 48px;
    }
  }

  .sidebar-slot {
    width: 0;
    min-width: 0;
    @apply bg-stone-50;
    overflow: visible;
  }

  @media (min-width: 1024px) {
    .sidebar-slot {
      width: 256px;
      min-width: 256px;
      /* Left padding so the nav and search trigger never sit flush against
         the window edge when the container spans full width (≤1400px). */
      padding-left: 0.75rem;
      padding-right: 0.25rem;
      overflow: hidden;
    }
  }


  .docs-container {
    @apply flex w-full max-w-[1400px] mx-auto;
  }

  .toc-slot {
    @apply hidden xl:block;
    width: 200px;
    min-width: 200px;
    flex-shrink: 0;
    @apply bg-stone-50;
    padding-left: 0.75rem;
  }

  .docs-main {
    @apply flex-1 min-w-0 px-6 lg:px-12 pt-6 pb-16 min-h-[70vh];
    @apply bg-white;
    border-radius: 12px;
    margin-top: 0.75rem;
    margin-bottom: 0;
  }

  @media (min-width: 1024px) {
    .docs-main {
      margin-bottom: 2rem;
    }
  }

  .docs-main :global(p) {
    @apply leading-relaxed break-words mb-4;
  }

  .docs-main :global(a) {
    @apply text-sky-500 hover:text-sky-700 underline;
  }

  .docs-main :global(h1) {
    @apply text-4xl font-bold mb-6 mt-8;
  }

  .docs-main :global(h2) {
    @apply text-2xl font-bold mb-4 mt-8;
  }

  .docs-main :global(h3) {
    @apply text-xl font-bold mb-3 mt-6;
  }

  .docs-main :global(h4) {
    @apply text-lg font-semibold mb-2 mt-5;
  }

  .docs-main :global(ul) {
    @apply list-disc pl-6 mb-4;
  }

  .docs-main :global(ol) {
    @apply list-decimal pl-6 mb-4;
  }

  .docs-main :global(li) {
    @apply mb-1;
  }

  .docs-main :global(code) {
    @apply rounded px-1.5 py-0.5 text-sm font-mono;
    @apply bg-stone-50;
    overflow-wrap: break-word;
  }

  .docs-main :global(pre) {
    @apply rounded-lg p-4 mb-4 overflow-x-auto;
  }

  .docs-main :global(pre code) {
    @apply bg-transparent p-0;
  }

  .docs-main :global(img) {
    @apply max-w-full rounded-lg my-4 mx-auto block;
  }

  .docs-main :global(blockquote) {
    @apply border-l-4 border-sky-300 pl-4 italic my-4;
  }

  .docs-main :global(.table-scroll) {
    @apply overflow-x-auto;
    -webkit-overflow-scrolling: touch;
  }

  .docs-main :global(table) {
    @apply w-full mb-4 text-sm;
    border-collapse: collapse;
  }

  .docs-main :global(thead tr) {
    @apply bg-stone-50;
  }

  .docs-main :global(th) {
    @apply font-semibold text-left;
    padding: 0.5rem 0.75rem;
    @apply border-b;
  }

  .docs-main :global(th + th) {
    @apply border-l;
  }

  .docs-main :global(td) {
    padding: 0.5rem 0.75rem;
    @apply border-b;
  }

  .docs-main :global(td + td) {
    @apply border-l;
  }

  /* On narrow viewports, auto layout gives each column exactly as much
     room as its content demands — for tables with several short columns
     (In/Type/Required) plus a prose column (Description), that reliably
     exceeds the viewport. Switch to fixed layout with a floor per cell:
     widths become deterministic (short cells keep one line, prose wraps
     normally) instead of reactive to content, and only if the floors
     themselves can't all fit does the .table-scroll / .api-section /
     .api-response-body overflow-x: auto kick in as a fallback. Left
     alone above this breakpoint — auto layout already looks right once
     there's enough room for content to drive column widths. */
  @media (max-width: 640px) {
    .docs-main :global(table) {
      table-layout: fixed;
    }

    .docs-main :global(th),
    .docs-main :global(td) {
      min-width: 4rem;
    }
  }

  .docs-main :global(tbody tr:last-child td) {
    border-bottom: none;
  }

  /* YouTube embed */
  .docs-main :global(.youtube-embed) {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: none;
    border-radius: 8px;
    margin: 1rem 0;
  }

  /* DoltHub SQL console embed */
  .docs-main :global(.dolthub-embed-wrapper) {
    margin: 1rem 0;
    @apply border;
    border-radius: 8px;
    overflow: hidden;
  }

  .docs-main :global(.dolthub-embed) {
    width: 100%;
    height: 400px;
    border: none;
    display: block;
  }

  .docs-main :global(.dolthub-embed-fallback) {
    display: block;
    padding: 0.5rem 1rem;
    font-size: 0.8rem;
    text-align: center;
    background: #f8f9fa;
    @apply border-t;
    text-decoration: none !important;
  }

  /* API endpoint styles */
  .docs-main :global(.api-endpoint) {
    border-radius: 8px;
    margin: 1.5rem 0;
    overflow: hidden;
  }

  .docs-main :global(.api-endpoint-header) {
    display: flex;
    align-items: center;
    padding: 0.75rem 0;
    font-family: "Space Mono", monospace;
  }

  .docs-main :global(.api-method) {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    margin-right: 0.75rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 700;
    color: #0f172a;
    letter-spacing: 0.05em;
    line-height: 1.4;
  }

  .docs-main :global(.api-path) {
    font-size: 0.875rem;
    font-weight: 600;
    background: none !important;
    padding: 0 !important;
    color: inherit;
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .docs-main :global(.api-summary) {
    padding: 0.75rem 0 0;
    font-weight: 600;
    margin: 0;
  }

  .docs-main :global(.api-description) {
    padding: 0.25rem 0 0;
    margin: 0;
    opacity: 0.8;
  }

  .docs-main :global(.api-url) {
    padding: 0.5rem 0;
    font-size: 0.875rem;
  }

  .docs-main :global(.api-url code) {
    font-size: 0.8rem;
  }

  .docs-main :global(.api-section) {
    padding: 0 0 0.75rem;
    overflow-x: auto;
  }

  .docs-main :global(.api-section h5) {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0.75rem 0 0.5rem;
    opacity: 0.6;
  }

  .docs-main :global(.api-params) {
    font-size: 0.8125rem;
    margin: 0 0 1rem !important;
  }

  .docs-main :global(.api-example) {
    word-break: break-all;
    white-space: normal;
  }

  .docs-main :global(.api-params th) {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    opacity: 0.7;
  }

  .docs-main :global(.api-response) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0;
    font-size: 0.875rem;
  }

  .docs-main :global(.api-status-success) {
    display: inline-block;
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 700;
    font-family: "Space Mono", monospace;
    background: #d4edda;
    color: #155724;
  }

  .docs-main :global(.api-status-error) {
    display: inline-block;
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 700;
    font-family: "Space Mono", monospace;
    background: #f8d7da;
    color: #721c24;
  }

  /* Per-response body block (sample JSON + fields table). Indented under
     the status-code line, so each response's shape sits visually beneath
     its code. */
  .docs-main :global(.api-response-body) {
    margin: 0.25rem 0 0.75rem 1rem;
    font-size: 0.875rem;
    overflow-x: auto;
  }

  .docs-main :global(.api-response-body p) {
    margin: 0.25rem 0;
    color: #555;
  }

  .docs-main :global(.api-response-example) {
    margin: 0.25rem 0 0.5rem 0;
    padding: 0.5rem 0.75rem;
    background: #f6f8fa;
    border-radius: 4px;
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .docs-main :global(.api-response-example code) {
    background: transparent;
    padding: 0;
    font-family: "Space Mono", monospace;
    white-space: pre;
  }

  .bottomOuter {
    @apply w-full overflow-hidden bg-space-500;
  }

  .bottom {
    @apply z-10 relative mx-auto overflow-hidden w-11/12 xl:w-3/4;
  }
</style>

<style is:global>
  /* Shared sidebar nav styles */
  .sidebar-section {
    @apply mb-4;
  }

  .sidebar-section-title {
    @apply text-xs font-bold uppercase tracking-wider px-4 py-2;
    color: rgba(var(--color-primary), 0.5);
  }

  .sidebar-list {
    @apply list-none p-0 m-0;
  }

  .sidebar-children {
    @apply list-none p-0 m-0;
  }

  .sidebar-row {
    display: flex;
    align-items: center;
    border-radius: 6px;
    padding-left: 0.25rem;
  }

  .sidebar-row-active {
    @apply bg-sky-50;
  }

  .sidebar-row-active .sidebar-link {
    @apply font-semibold;
    color: rgba(var(--color-primary), 1);
  }

  .sidebar-link {
    @apply block w-full text-left text-sm py-1 pr-3 no-underline;
    color: rgba(var(--color-primary), 0.7);
  }

  .sidebar-link:hover {
    color: rgba(var(--color-primary), 1);
    @apply no-underline;
  }

  .sidebar-link-section {
    @apply cursor-pointer bg-transparent border-none font-medium;
  }

  .sidebar-chevron {
    @apply flex items-center justify-center w-5 h-5 shrink-0 cursor-pointer bg-transparent border-none p-0;
    color: rgba(var(--color-primary), 0.4);
  }

  .sidebar-chevron:hover {
    color: rgba(var(--color-primary), 0.8);
  }

  .sidebar-chevron-hidden {
    visibility: hidden;
    cursor: default;
  }

  /* Desktop sidebar. Fill the slot (w-full) rather than a fixed w-64: the slot
     is itself 256px wide with horizontal padding, so a fixed 256px sidebar
     overflows that padding and gets clipped right at the white content card —
     making the row highlights touch it (the gap otherwise only existed by
     grace of the scrollbar width, which is 0 with macOS overlay scrollbars).
     Filling the slot lets the padding-right below produce a real, consistent
     gap before the card. */
  .sidebar-desktop {
    @apply hidden lg:block w-full shrink-0 overflow-y-auto;
    position: sticky;
    top: 0;
    height: 100vh;
    padding: 1.5rem 0.5rem 1.5rem 0;
    scrollbar-width: thin;
    scrollbar-color: #D7D8DF transparent;
  }

  .sidebar-desktop::-webkit-scrollbar {
    width: 4px;
  }

  .sidebar-desktop::-webkit-scrollbar-track {
    background: transparent;
  }

  .sidebar-desktop::-webkit-scrollbar-thumb {
    @apply bg-stone-100;
    border-radius: 4px;
  }

  .sidebar-desktop::-webkit-scrollbar-thumb:hover {
    background: #aaa;
  }

  /* Mobile toggle button */
  .sidebar-mobile-toggle {
    @apply flex lg:hidden items-center gap-2 px-4 py-3 text-sm w-full cursor-pointer;
    @apply bg-stone-50;
    color: rgba(var(--color-primary), 0.9);
    border: none;
    border-bottom: 1px solid #d7d8df;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .sidebar-mobile-toggle:hover {
    color: rgba(var(--color-primary), 1);
    background: #e9ebf1;
  }

  .sidebar-mobile-toggle svg:first-child {
    width: 1.1rem;
    height: 1.1rem;
  }

  .sidebar-mobile-chevron {
    margin-left: auto;
    opacity: 0.7;
  }

  /* Mobile overlay */
  .sidebar-overlay {
    @apply fixed inset-0 z-40 lg:hidden;
    background: rgba(0, 0, 0, 0.3);
  }

  /* Mobile drawer */
  .sidebar-mobile {
    @apply fixed top-0 left-0 z-50 bg-white shadow-lg overflow-y-auto lg:hidden;
    width: 300px;
    height: 100vh;
    padding: 0 0 2rem;
    transform: translateX(-100%);
    transition: transform 0.2s ease-in-out;
  }

  .sidebar-mobile-open {
    transform: translateX(0);
  }

  .sidebar-mobile-header {
    @apply flex justify-end p-3;
  }

  .sidebar-mobile-close {
    @apply flex items-center justify-center w-8 h-8 rounded cursor-pointer bg-transparent border-none;
    color: rgba(var(--color-primary), 0.5);
  }

  .sidebar-mobile-close:hover {
    color: rgba(var(--color-primary), 1);
    @apply bg-stone-50;
  }

  .sidebar-mobile-search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: calc(100% - 1.5rem);
    margin: 0 0.75rem 0.75rem;
    padding: 0.5rem 0.75rem;
    @apply border;
    border-radius: 6px;
    @apply bg-white;
    cursor: pointer;
    font-size: 0.85rem;
    color: #999;
  }

  .sidebar-mobile-search:hover {
    border-color: #aaa;
    background: #f8f9fb;
  }

  /* Search trigger button — lives inside the sidebar */
  .search-trigger {
    @apply hidden lg:flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.75rem 0 0.5rem 0;
    padding: 0.5rem 0.75rem;
    @apply border;
    border-radius: 6px;
    @apply bg-white;
    cursor: pointer;
    font-size: 0.8rem;
    color: #999;
    transition: border-color 0.15s, background 0.15s;
    width: 90%;
    box-sizing: border-box;
  }

  .search-trigger:hover {
    border-color: #aaa;
    background: #f8f9fa;
  }

  .search-trigger svg {
    flex-shrink: 0;
    opacity: 0.5;
  }

  .search-trigger-text {
    flex: 1;
    text-align: left;
  }

  .search-trigger-kbd {
    display: none;
    font-size: 0.6rem;
    padding: 0.1rem 0.3rem;
    @apply border;
    border-radius: 3px;
    @apply bg-white;
    color: #999;
    font-family: inherit;
    line-height: 1.3;
  }

  @media (min-width: 1024px) {
    .search-trigger-kbd {
      display: inline-block;
    }
  }

  .search-trigger-kbd-meta {
    font-size: 0.7rem;
  }

  /* Search modal */
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 8vh;
    animation: fadeIn 0.15s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .search-modal {
    width: 90%;
    max-width: 600px;
    max-height: 75vh;
    @apply bg-white;
    border-radius: 12px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(0, 0, 0, 0.05);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    animation: slideDown 0.15s ease-out;
  }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .search-container {
    --pagefind-ui-scale: 0.85;
    --pagefind-ui-primary: #327DD2;
    --pagefind-ui-text: #333;
    --pagefind-ui-background: #fff;
    --pagefind-ui-border: #e5e7eb;
    --pagefind-ui-border-width: 0;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-font: "Source Sans Pro", sans-serif;
    overflow-y: auto;
    max-height: 75vh;
    padding: 1rem 1.5rem;
  }

  /* Search input styling */
  .search-container :global(.pagefind-ui__search-input) {
    @apply border;
    border-radius: 8px;
    font-weight: 400;
    background: #f8f9fb;
  }

  .search-container :global(.pagefind-ui__search-input:focus) {
    @apply border-sky-500;
    outline: none;
    @apply bg-white;
    box-shadow: 0 0 0 3px rgba(50, 125, 210, 0.1);
  }

  /* Result items */
  .search-container :global(.pagefind-ui__result) {
    padding: 0.75rem 0;
    border-color: #f0f1f3;
  }

  .search-container :global(.pagefind-ui__result-title) {
    font-size: 0.95rem;
  }

  .search-container :global(.pagefind-ui__result-link) {
    @apply text-sky-500;
    font-weight: 600;
  }

  .search-container :global(.pagefind-ui__result-link:hover) {
    text-decoration: underline;
  }

  .search-container :global(.pagefind-ui__result-excerpt) {
    font-size: 0.85rem;
    line-height: 1.5;
    color: #666;
  }

  /* Message (e.g. "3 results for...") */
  .search-container :global(.pagefind-ui__message) {
    font-size: 0.8rem;
    color: #999;
    font-weight: 400;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #f0f1f3;
  }

  /* Load more button */
  .search-container :global(.pagefind-ui__button) {
    @apply border;
    border-radius: 8px;
    font-weight: 500;
    color: #666;
    background: #f8f9fb;
  }

  .search-container :global(.pagefind-ui__button:hover) {
    background: #f0f1f3;
    border-color: #aaa;
    color: #333;
  }

  /* Clear button */
  .search-container :global(.pagefind-ui__search-clear) {
    color: #999;
    font-size: 0.75rem;
  }


  /* Table of contents (right sidebar) */
  .toc {
    position: sticky;
    top: 1rem;
    padding: 1rem 0;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: #D7D8DF transparent;
  }

  .toc::-webkit-scrollbar {
    width: 4px;
  }

  .toc::-webkit-scrollbar-track {
    background: transparent;
  }

  .toc::-webkit-scrollbar-thumb {
    @apply bg-stone-100;
    border-radius: 4px;
  }

  .toc::-webkit-scrollbar-thumb:hover {
    background: #aaa;
  }

  .toc-title {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
    padding-left: 0.75rem;
    opacity: 0.5;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item-nested {
    padding-left: 0.75rem;
  }

  .toc-link {
    display: block;
    padding: 0.2rem 0.75rem;
    font-size: 0.775rem;
    line-height: 1.4;
    color: rgba(var(--color-primary), 0.5) !important;
    text-decoration: none !important;
  }

  .toc-link:hover {
    color: rgba(var(--color-primary), 0.8) !important;
  }

  .toc-link-active {
    color: rgba(var(--color-primary), 1) !important;
    font-weight: 600;
  }

  /* Anchor links */
  .anchor-link {
    @apply hidden;
  }

  .docs-main h1:hover .anchor-link,
  .docs-main h2:hover .anchor-link,
  .docs-main h3:hover .anchor-link,
  .docs-main h4:hover .anchor-link {
    @apply inline-block ml-3;
  }

  /* Override Pagefind's "all: revert" on mark which resets to browser yellow */
  .pagefind-ui--reset mark,
  .pagefind-ui mark {
    all: unset;
    @apply bg-sky-50;
    color: inherit;
    border-radius: 2px;
    padding: 0.05em 0.15em;
  }
</style>

<style is:global>
  /* Dark mode — toggled by the navbar button (adds `dark` to <html>).
     The navbar is fully themed (dark background + light text/icons). The
     other text-bearing surfaces (content card, sidebar, TOC) are still
     light pending the rest of the palette — their colors come from the
     `--color-primary` brand variable that ThemeProvider sets inline on
     <html>, so those need per-surface overrides, not a single var flip. */
  html.dark {
    color-scheme: dark;
  }
  html.dark .navbar-slot,
  html.dark .navbar-slot .bg-space-900 {
    background: #0e141f;
  }
  html.dark body {
    background: #0e141f;
    color: #e6edf3;
  }

  /* The main content card is a lighter dark than the #0e141f backdrop/navs,
     so the document reads as a raised surface. Its text has no explicit
     color (the markdown headings/paragraphs only @apply layout utilities),
     so it inherits the light body color above — no per-element override
     needed. (Callouts still use light values and are a later pass.) */
  html.dark .docs-main {
    background: #151d2b;
  }

  html.dark .docs-main a {
    color: #8fc1fa;
  }
  html.dark .docs-main a:hover {
    color: #c5dffc;
  }

  /* Tables: the light header fill and grey cell borders don't read on the
     dark card. Give the header a slightly-raised fill (#212d40 over the
     #151d2b card) and switch all cell borders to #303e54; cell text keeps
     the inherited light body color. */
  html.dark .docs-main thead tr {
    background: #212d40;
  }
  html.dark .docs-main th,
  html.dark .docs-main td {
    border-bottom-color: #303e54;
  }
  html.dark .docs-main th + th,
  html.dark .docs-main td + td {
    border-left-color: #303e54;
  }

  /* DoltHub API endpoint blocks: the method badges (.api-method) and
     status pills keep their own colors, and the path/summary text
     inherits the light body color. */
  html.dark .docs-main .api-response-body p {
    color: rgba(230, 237, 243, 0.7);
  }
  html.dark .docs-main .api-response-example {
    background: #0e141f;
  }

  /* Inline code: the light #f1f3f8 swatch would show light text on a light
     background on the dark card, so swap it for a translucent blue that
     stands out against #151d2b (text stays the inherited light body color).
     Fenced blocks keep their Shiki github-dark colors — reset pre code back
     to transparent so this background doesn't sit behind the code block. */
  html.dark .docs-main code {
    background: rgba(69, 85, 110, 0.3);
  }
  html.dark .docs-main pre code {
    background: transparent;
  }

  /* Left nav (sidebar) and right nav (TOC): dark panels matching the
     backdrop, so the content card reads as the raised surface. Their text
     uses rgba(var(--color-primary), α) at several opacities; re-scope
     --color-primary to a light value within each subtree so all of it goes
     light while keeping the opacity hierarchy — no per-element overrides.
     (ThemeProvider sets --color-primary inline on <html>; re-declaring it on
     these containers wins for their descendants by proximity.) */
  html.dark .sidebar-slot,
  html.dark .toc-slot {
    background: #0e141f;
    --color-primary: 230, 237, 243;
  }
  html.dark .sidebar-row-active {
    background: rgba(110, 145, 185, 0.15);
  }
  html.dark .sidebar-desktop {
    scrollbar-color: #303e54 transparent;
  }
  html.dark .sidebar-desktop::-webkit-scrollbar-thumb {
    background: #303e54;
  }
  html.dark .sidebar-desktop::-webkit-scrollbar-thumb:hover {
    background: #45556e;
  }

  /* Mobile docs nav — the "Table of contents" toggle bar and the slide-out
     drawer. MobileSidebar renders outside .sidebar-slot, so the re-scope
     above doesn't reach it: give the bar and drawer their own dark surfaces
     and re-scope --color-primary so the nav text/links go light to match the
     desktop sidebar. (.sidebar-row-active and .sidebar-mobile-search already
     have global dark rules that apply here too.) */
  html.dark .sidebar-mobile-toggle {
    background: #151d2b;
    border-bottom-color: #303e54;
    --color-primary: 230, 237, 243;
  }
  html.dark .sidebar-mobile-toggle:hover {
    background: #212d40;
  }
  html.dark .sidebar-mobile {
    background: #0e141f;
    --color-primary: 230, 237, 243;
  }
  html.dark .sidebar-mobile-close:hover {
    background: rgba(230, 237, 243, 0.08);
  }

  /* Footer: the footer area (.bottomOuter) is already a dark navy in light
     mode (bg-space-500 = #202F57) with light text — version/links use the
     brand --color-link-light var and copyright is a muted blue-grey. So
     matching dark mode only means dropping the background to the #0e141f
     backdrop, so the footer reads as part of the chrome rather than a
     separate navy block. The light text needs no override. */
  html.dark .bottomOuter {
    background: #0e141f;
  }

  /* Search trigger (the "box" in the sidebar) and its mobile twin: light
     surfaces by default (white bg, #999 text). Darken to a raised panel so
     they sit on the dark sidebar. */
  html.dark .search-trigger,
  html.dark .sidebar-mobile-search {
    background: #151d2b;
    border-color: #303e54;
    color: #8b949e;
  }
  html.dark .search-trigger:hover,
  html.dark .sidebar-mobile-search:hover {
    background: #212d40;
    border-color: #45556e;
  }
  html.dark .search-trigger-kbd {
    background: #151d2b;
    border-color: #303e54;
    color: #8b949e;
  }

  /* Search modal + Pagefind UI. The modal shell and most Pagefind internals
     read from the --pagefind-ui-* vars (re-pointed to dark values here).
     Pagefind injects its .pagefind-ui__* tree inside .search-container, so
     plain descendant selectors reach the same elements the light rules
     target. (Note: those light rules wrap the selector in :global(), which
     is a no-op outside a scoped <style> — emitted literally and dropped by
     the browser — so the light modal is really driven by Pagefind's own
     stylesheet plus the vars. We use bare selectors so the dark overrides
     actually apply.) */
  html.dark .search-modal {
    background: #151d2b;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(230, 237, 243, 0.1);
  }
  html.dark .search-container {
    --pagefind-ui-primary: #8fc1fa;
    --pagefind-ui-text: #e6edf3;
    --pagefind-ui-background: #151d2b;
    --pagefind-ui-border: #303e54;
  }
  html.dark .search-container .pagefind-ui__search-input {
    border-color: #303e54;
    background: #0e141f;
    color: #e6edf3;
  }
  html.dark .search-container .pagefind-ui__search-input:focus {
    border-color: #58a6ff;
    background: #0e141f;
    box-shadow: 0 0 0 3px rgba(88, 166, 255, 0.15);
  }
  html.dark .search-container .pagefind-ui__result {
    border-color: #303e54;
  }
  html.dark .search-container .pagefind-ui__result-link {
    color: #8fc1fa;
  }
  html.dark .search-container .pagefind-ui__result-link:hover {
    color: #c5dffc;
  }
  html.dark .search-container .pagefind-ui__result-excerpt {
    color: #8b949e;
  }
  html.dark .search-container .pagefind-ui__message {
    color: #8b949e;
    border-bottom-color: #303e54;
  }
  html.dark .search-container .pagefind-ui__button {
    border-color: #303e54;
    background: #212d40;
    color: #c9d1d9;
  }
  html.dark .search-container .pagefind-ui__button:hover {
    background: #303e54;
    border-color: #45556e;
    color: #e6edf3;
  }
  html.dark .search-container .pagefind-ui__search-clear {
    color: #8b949e;
  }

  /* Search-result highlight: the light #D4E7FC swatch would wash out under
     light text, so use a translucent blue that reads on the dark modal. */
  html.dark .pagefind-ui--reset mark,
  html.dark .pagefind-ui mark {
    background: rgba(110, 145, 185, 0.35);
    color: #e6edf3;
  }
</style>
