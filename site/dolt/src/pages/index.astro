---
// The docs root (e.g. https://www.dolthub.com/docs/) redirects to the
// "What Is Dolt?" page. In production, the real 301 comes from the
// Cloudflare `_redirects` rule (see this site's `_redirects` file) — that
// fires before this static page is served, so the page is normally never
// rendered. The meta refresh and visible link below are a no-JS fallback
// for the rare case the host serves the static asset instead of honoring
// `_redirects`. No JS-driven `location.replace`: a client-side bounce
// would double request count through any flaky upstream proxy.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const target = `${base}/introduction/what-is-dolt`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Dolt Documentation</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
  </head>
  <body>
    <p>Redirecting to <a href={target}>What Is Dolt?</a>…</p>
  </body>
</html>
