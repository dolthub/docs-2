---
// The docs root (e.g. https://www.dolthub.com/docs/) redirects to the
// "What Is Dolt?" page. Static site (no SSR), so this is a client/meta
// redirect: location.replace for browsers/Cypress, a meta refresh fallback
// for no-JS, and a canonical link for crawlers.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const target = `${base}/introduction/what-is-dolt`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Dolt Documentation</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <script define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body>
    <p>Redirecting to <a href={target}>What Is Dolt?</a>…</p>
  </body>
</html>
