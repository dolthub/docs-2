---
// The docs root 301s to the intro via the Cloudflare `_redirects` rule; this
// static page is only a no-JS fallback for when the host serves the asset
// instead. No client-side redirect — that would double requests via proxies.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const target = `${base}/introduction/what-is-dolt`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Dolt Documentation</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
  </head>
  <body>
    <p>Redirecting to <a href={target}>What Is Dolt?</a>…</p>
  </body>
</html>
