---
import { Navbar, Footer, Sidebar } from "../../../shared/components";
import nav from "../nav";

export interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Dolt Docs</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap"
    />
  </head>
  <body>
    <div>
      <div class="navbar-slot">
        <Navbar client:only="react" />
      </div>

      <div class="docs-container">
        <div class="sidebar-slot">
          <Sidebar client:only="react" nav={nav} currentPath={currentPath} />
        </div>

        <main class="docs-main">
          <article class="docs-article">
            <slot />
          </article>
        </main>
      </div>

      <div class="bottomOuter">
        <div class="bottom">
          <Footer client:only="react" />
        </div>
      </div>
    </div>
  </body>
</html>

<style>
  /* Reserve space for client-only components to prevent layout shift */
  .navbar-slot {
    min-height: 48px;
  }

  .sidebar-slot {
    @apply hidden lg:block;
    width: 256px;
    min-width: 256px;
    border-right: 1px solid #D7D8DF;
  }

  .docs-container {
    @apply flex w-full max-w-[1400px] mx-auto;
  }

  .docs-main {
    @apply flex-1 min-w-0 px-6 lg:px-12 pt-8 pb-16 min-h-[70vh];
  }

  .docs-main :global(p) {
    @apply leading-relaxed break-words mb-4;
  }

  .docs-main :global(a) {
    @apply text-sky-500 hover:text-sky-700 underline;
  }

  .docs-main :global(h1) {
    @apply text-4xl font-bold mb-6 mt-8;
  }

  .docs-main :global(h2) {
    @apply text-2xl font-bold mb-4 mt-8;
  }

  .docs-main :global(h3) {
    @apply text-xl font-bold mb-3 mt-6;
  }

  .docs-main :global(ul) {
    @apply list-disc pl-6 mb-4;
  }

  .docs-main :global(ol) {
    @apply list-decimal pl-6 mb-4;
  }

  .docs-main :global(li) {
    @apply mb-1;
  }

  .docs-main :global(code) {
    @apply bg-stone-100 rounded px-1.5 py-0.5 text-sm font-mono;
  }

  .docs-main :global(pre) {
    @apply rounded-lg p-4 mb-4 overflow-x-auto;
  }

  .docs-main :global(pre code) {
    @apply bg-transparent p-0;
  }

  .docs-main :global(img) {
    @apply max-w-full rounded-lg my-4;
  }

  .docs-main :global(blockquote) {
    @apply border-l-4 border-sky-300 pl-4 italic my-4;
  }

  .bottomOuter {
    @apply w-full mt-20 overflow-hidden bg-space-500;
  }

  .bottom {
    @apply z-10 relative mx-auto overflow-hidden w-11/12 xl:w-3/4;
  }
</style>

<style is:global>
  /* Sidebar styles */
  .sidebar {
    @apply w-64 shrink-0 overflow-y-auto;
    position: sticky;
    top: 0;
    height: 100vh;
    padding: 1.5rem 0;
  }

  .sidebar-section {
    @apply mb-4;
  }

  .sidebar-section-title {
    @apply text-xs font-bold uppercase tracking-wider px-4 py-2;
    color: rgba(var(--color-primary), 0.5);
  }

  .sidebar-list {
    @apply list-none p-0 m-0;
  }

  .sidebar-children {
    @apply list-none p-0 m-0;
  }

  .sidebar-link {
    @apply block w-full text-left text-sm py-1 pr-3 no-underline;
    color: rgba(var(--color-primary), 0.7);
  }

  .sidebar-link:hover {
    color: rgba(var(--color-primary), 1);
    @apply no-underline;
  }

  .sidebar-link-active {
    @apply font-semibold;
    color: rgba(var(--color-primary), 1);
    @apply bg-sky-50;
    @apply rounded;
  }

  .sidebar-link-section {
    @apply cursor-pointer bg-transparent border-none font-medium;
  }

  .sidebar-chevron {
    @apply flex items-center justify-center w-5 h-5 shrink-0 cursor-pointer bg-transparent border-none p-0;
    color: rgba(var(--color-primary), 0.4);
  }

  .sidebar-chevron:hover {
    color: rgba(var(--color-primary), 0.8);
  }

  /* Mobile sidebar */
  .sidebar-mobile-toggle {
    @apply flex lg:hidden items-center gap-2 px-4 py-2 text-sm font-medium border-b border-stone-300 w-full bg-white cursor-pointer;
    color: rgba(var(--color-primary), 0.7);
  }

  .sidebar-overlay {
    @apply fixed inset-0 bg-space-700/50 z-40 lg:hidden;
  }

  @media (max-width: 1023px) {
    .sidebar {
      @apply fixed top-0 left-0 z-50 bg-white shadow-lg;
      display: none;
      width: 280px;
      padding-top: 1rem;
    }

    .sidebar-open {
      display: block;
    }
  }

  /* Anchor links */
  .anchor-link {
    @apply hidden;
  }

  .docs-main h1:hover .anchor-link,
  .docs-main h2:hover .anchor-link,
  .docs-main h3:hover .anchor-link,
  .docs-main h4:hover .anchor-link {
    @apply inline-block ml-3;
  }
</style>
